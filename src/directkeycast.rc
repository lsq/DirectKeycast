#include <winres.h>
#include "resource.h"
#include "version.h"

IDI_APP_ICON ICON "../assets/icons/directkeycast.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION DK_VERSION_MAJOR,DK_VERSION_MINOR,DK_VERSION_PATCH,0
 PRODUCTVERSION DK_VERSION_MAJOR,DK_VERSION_MINOR,DK_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "fanlusky"
            VALUE "FileDescription", "DirectKeycast - keystroke overlay"
            VALUE "FileVersion", DK_VERSION_STRING
            VALUE "InternalName", "directkeycast"
            VALUE "OriginalFilename", "directkeycast.exe"
            VALUE "ProductName", "DirectKeycast"
            VALUE "ProductVersion", DK_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
